{% doc %}
  @prompt
    Create a testimonials carousel section with a warm beige/tan background. The section has a bold heading "What people are saying" centered at the top. Below are testimonial cards displayed in a horizontal slider/carousel (4 visible at a time on desktop). Each card is white with rounded corners and contains: 5 gold star rating at the top, a product focus title in bold, a short quote preview in regular text, and a pink/magenta "Read more" link. Below each card (outside the card) shows the reviewer's avatar (circular photo), their name in bold with a pink verified checkmark, and their title/role in gray text. The carousel has left/right arrow navigation buttons and dot indicators at the bottom. Cards should have a subtle shadow. The overall section padding should be generous with the beige background extending edge to edge.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    background-color: {{ block.settings.background_color }};
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
  }

  .ai-testimonials-carousel__container-{{ ai_gen_id }} {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonials-carousel__heading-{{ ai_gen_id }} {
    text-align: center;
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 700;
    color: {{ block.settings.heading_color }};
  }

  .ai-testimonials-carousel__slider-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
    margin-bottom: 40px;
  }

  .ai-testimonials-carousel__slider-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
    padding: 10px 0;
  }

  .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.cards_per_view | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_view }});
    min-width: 0;
  }

  .ai-testimonials-carousel__card-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: {{ block.settings.card_shadow_x }}px {{ block.settings.card_shadow_y }}px {{ block.settings.card_shadow_blur }}px {{ block.settings.card_shadow_color }};
    height: 100%;
    display: flex;
    flex-direction: column;
  }

  .ai-testimonials-carousel__stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    margin-bottom: 16px;
  }

  .ai-testimonials-carousel__star-{{ ai_gen_id }} {
    width: {{ block.settings.star_size }}px;
    height: {{ block.settings.star_size }}px;
    fill: {{ block.settings.star_color }};
  }

  .ai-testimonials-carousel__product-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_title_size }}px;
    font-weight: 700;
    color: {{ block.settings.text_color }};
    margin: 0 0 12px;
  }

  .ai-testimonials-carousel__quote-{{ ai_gen_id }} {
    font-size: {{ block.settings.quote_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0 0 16px;
    flex-grow: 1;
  }

  .ai-testimonials-carousel__read-more-{{ ai_gen_id }} {
    color: {{ block.settings.link_color }};
    text-decoration: none;
    font-size: {{ block.settings.link_size }}px;
    font-weight: 500;
    display: inline-block;
  }

  .ai-testimonials-carousel__read-more-{{ ai_gen_id }}:hover {
    text-decoration: underline;
  }

  .ai-testimonials-carousel__author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: 16px;
  }

  .ai-testimonials-carousel__avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-testimonials-carousel__avatar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: #e0e0e0;
    flex-shrink: 0;
  }

  .ai-testimonials-carousel__author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonials-carousel__author-name-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 6px;
    font-weight: 700;
    font-size: {{ block.settings.author_name_size }}px;
    color: {{ block.settings.text_color }};
    margin: 0 0 4px;
  }

  .ai-testimonials-carousel__verified-{{ ai_gen_id }} {
    width: 16px;
    height: 16px;
    fill: {{ block.settings.verified_color }};
  }

  .ai-testimonials-carousel__author-role-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_role_size }}px;
    color: {{ block.settings.role_color }};
    margin: 0;
  }

  .ai-testimonials-carousel__nav-{{ ai_gen_id }} {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    background-color: {{ block.settings.nav_button_background }};
    border: none;
    width: {{ block.settings.nav_button_size }}px;
    height: {{ block.settings.nav_button_size }}px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.15);
    z-index: 2;
  }

  .ai-testimonials-carousel__nav-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover }};
  }

  .ai-testimonials-carousel__nav-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-testimonials-carousel__nav--prev-{{ ai_gen_id }} {
    left: -{{ block.settings.nav_button_size | divided_by: 2 }}px;
  }

  .ai-testimonials-carousel__nav--next-{{ ai_gen_id }} {
    right: -{{ block.settings.nav_button_size | divided_by: 2 }}px;
  }

  .ai-testimonials-carousel__nav-icon-{{ ai_gen_id }} {
    width: 20px;
    height: 20px;
    stroke: {{ block.settings.nav_button_icon }};
    stroke-width: 2;
  }

  .ai-testimonials-carousel__dots-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 8px;
  }

  .ai-testimonials-carousel__dot-{{ ai_gen_id }} {
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    border: none;
    cursor: pointer;
    padding: 0;
  }

  .ai-testimonials-carousel__dot-{{ ai_gen_id }}.active {
    background-color: {{ block.settings.dot_active_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.cards_per_view_tablet | minus: 1 }} * {{ block.settings.card_gap }}px)) / {{ block.settings.cards_per_view_tablet }});
    }

    .ai-testimonials-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.8 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonials-carousel__slide-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-testimonials-carousel__heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
    }

    .ai-testimonials-carousel__nav-{{ ai_gen_id }} {
      display: none;
    }
  }
{% endstyle %}

<testimonials-carousel-{{ ai_gen_id }} class="ai-testimonials-carousel-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-testimonials-carousel__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-testimonials-carousel__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
    {% endif %}

    <div class="ai-testimonials-carousel__slider-wrapper-{{ ai_gen_id }}">
      <button
        class="ai-testimonials-carousel__nav-{{ ai_gen_id }} ai-testimonials-carousel__nav--prev-{{ ai_gen_id }}"
        aria-label="Previous testimonials"
        data-prev
      >
        <svg class="ai-testimonials-carousel__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
      </button>

      <div class="ai-testimonials-carousel__slider-{{ ai_gen_id }}" data-slider>
        {% for i in (1..8) %}
          {% liquid
            assign testimonial_enabled_key = 'testimonial_' | append: i | append: '_enabled'
            assign product_title_key = 'testimonial_' | append: i | append: '_product_title'
            assign quote_key = 'testimonial_' | append: i | append: '_quote'
            assign link_key = 'testimonial_' | append: i | append: '_link'
            assign avatar_key = 'testimonial_' | append: i | append: '_avatar'
            assign name_key = 'testimonial_' | append: i | append: '_name'
            assign role_key = 'testimonial_' | append: i | append: '_role'
            assign verified_key = 'testimonial_' | append: i | append: '_verified'

            assign testimonial_enabled = block.settings[testimonial_enabled_key]
            assign product_title = block.settings[product_title_key]
            assign quote = block.settings[quote_key]
            assign link = block.settings[link_key]
            assign avatar = block.settings[avatar_key]
            assign name = block.settings[name_key]
            assign role = block.settings[role_key]
            assign verified = block.settings[verified_key]
          %}

          {% if testimonial_enabled %}
            <div class="ai-testimonials-carousel__slide-{{ ai_gen_id }}">
              <div class="ai-testimonials-carousel__card-{{ ai_gen_id }}">
                <div class="ai-testimonials-carousel__stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    <svg class="ai-testimonials-carousel__star-{{ ai_gen_id }}" viewBox="0 0 24 24">
                      <path d="M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z"/>
                    </svg>
                  {% endfor %}
                </div>

                {% if product_title != blank %}
                  <h3 class="ai-testimonials-carousel__product-title-{{ ai_gen_id }}">{{ product_title }}</h3>
                {% endif %}

                {% if quote != blank %}
                  <p class="ai-testimonials-carousel__quote-{{ ai_gen_id }}">{{ quote }}</p>
                {% endif %}

                {% if link != blank %}
                  <a href="{{ link }}" class="ai-testimonials-carousel__read-more-{{ ai_gen_id }}">
                    {{ block.settings.read_more_text }}
                  </a>
                {% endif %}
              </div>

              <div class="ai-testimonials-carousel__author-{{ ai_gen_id }}">
                {% if avatar != blank %}
                  <img
                    src="{{ avatar | image_url: width: 100 }}"
                    alt="{{ name }}"
                    class="ai-testimonials-carousel__avatar-{{ ai_gen_id }}"
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  <div class="ai-testimonials-carousel__avatar-placeholder-{{ ai_gen_id }}"></div>
                {% endif %}

                <div class="ai-testimonials-carousel__author-info-{{ ai_gen_id }}">
                  {% if name != blank %}
                    <div class="ai-testimonials-carousel__author-name-{{ ai_gen_id }}">
                      {{ name }}
                      {% if verified %}
                        <svg class="ai-testimonials-carousel__verified-{{ ai_gen_id }}" viewBox="0 0 24 24">
                          <path d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" fill="currentColor"/>
                        </svg>
                      {% endif %}
                    </div>
                  {% endif %}

                  {% if role != blank %}
                    <p class="ai-testimonials-carousel__author-role-{{ ai_gen_id }}">{{ role }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      <button
        class="ai-testimonials-carousel__nav-{{ ai_gen_id }} ai-testimonials-carousel__nav--next-{{ ai_gen_id }}"
        aria-label="Next testimonials"
        data-next
      >
        <svg class="ai-testimonials-carousel__nav-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none">
          <polyline points="9 18 15 12 9 6"></polyline>
        </svg>
      </button>
    </div>

    <div class="ai-testimonials-carousel__dots-{{ ai_gen_id }}" data-dots></div>
  </div>
</testimonials-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardsPerView = {{ block.settings.cards_per_view }};
        this.cardsPerViewTablet = {{ block.settings.cards_per_view_tablet }};
      }

      connectedCallback() {
        this.slider = this.querySelector('[data-slider]');
        this.slides = Array.from(this.slider.children);
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.dotsContainer = this.querySelector('[data-dots]');

        this.updateCardsPerView();
        this.createDots();
        this.updateSlider();
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.prevButton.addEventListener('click', () => this.prev());
        this.nextButton.addEventListener('click', () => this.next());

        window.addEventListener('resize', () => {
          this.updateCardsPerView();
          this.createDots();
          this.updateSlider();
        });
      }

      updateCardsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.activeCardsPerView = 1;
        } else if (width <= 989) {
          this.activeCardsPerView = this.cardsPerViewTablet;
        } else {
          this.activeCardsPerView = this.cardsPerView;
        }
      }

      createDots() {
        this.dotsContainer.innerHTML = '';
        const totalSlides = this.slides.length;
        const totalDots = Math.ceil(totalSlides / this.activeCardsPerView);

        for (let i = 0; i < totalDots; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-testimonials-carousel__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', `Go to slide ${i + 1}`);
          dot.addEventListener('click', () => this.goToSlide(i));
          this.dotsContainer.appendChild(dot);
        }

        this.dots = Array.from(this.dotsContainer.children);
      }

      updateSlider() {
        const slideWidth = this.slides[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * this.activeCardsPerView * (slideWidth + gap));
        this.slider.style.transform = `translateX(${offset}px)`;

        this.updateDots();
        this.updateButtons();
      }

      updateDots() {
        this.dots.forEach((dot, index) => {
          if (index === this.currentIndex) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      updateButtons() {
        const maxIndex = Math.ceil(this.slides.length / this.activeCardsPerView) - 1;
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= maxIndex;
      }

      prev() {
        if (this.currentIndex > 0) {
          this.currentIndex--;
          this.updateSlider();
        }
      }

      next() {
        const maxIndex = Math.ceil(this.slides.length / this.activeCardsPerView) - 1;
        if (this.currentIndex < maxIndex) {
          this.currentIndex++;
          this.updateSlider();
        }
      }

      goToSlide(index) {
        this.currentIndex = index;
        this.updateSlider();
      }
    }

    customElements.define('testimonials-carousel-{{ ai_gen_id }}', TestimonialsCarousel{{ ai_gen_id }});
  })();
</script>

