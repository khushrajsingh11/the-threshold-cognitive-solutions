{% doc %}
  @prompt
    Add a "Read more / Show less" toggle feature to the existing Testimonials carousel block (section ID: template--20922922565799__product_list_fa6P9H, block ID: template--20922922565799__product_list_fa6P9H__ai_gen_block_f11cd32_VnYptV). Truncate long testimonial text to a maximum of 3 lines by default, and show a "Read more" link that expands the full text when clicked, and a "Show less" link to collapse it back. The toggle should be smooth with a CSS transition. Also ensure avatars are rendered and displayed at the bottom of each testimonial card using the existing avatar image settings.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-testimonials-carousel-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-testimonials-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-testimonials-header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 40px;
  }

  .ai-testimonials-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_size }}px;
    color: {{ block.settings.title_color }};
    margin: 0 0 16px;
  }

  .ai-testimonials-subtitle-{{ ai_gen_id }} {
    font-size: {{ block.settings.subtitle_size }}px;
    color: {{ block.settings.subtitle_color }};
    margin: 0;
  }

  .ai-testimonials-carousel-wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-testimonials-track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.card_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-testimonial-card-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - {{ block.settings.card_gap }}px * ({{ block.settings.cards_per_view | minus: 1 }})) / {{ block.settings.cards_per_view }});
    background-color: {{ block.settings.card_background }};
    border-radius: {{ block.settings.card_border_radius }}px;
    padding: {{ block.settings.card_padding }}px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .ai-testimonial-stars-{{ ai_gen_id }} {
    display: flex;
    gap: 4px;
    color: {{ block.settings.star_color }};
  }

  .ai-testimonial-text-wrapper-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    color: {{ block.settings.text_color }};
    line-height: 1.6;
    margin: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-testimonial-text-{{ ai_gen_id }}.collapsed {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    max-height: calc({{ block.settings.text_size }}px * 1.6 * 3);
  }

  .ai-testimonial-text-{{ ai_gen_id }}.expanded {
    max-height: 1000px;
  }

  .ai-testimonial-toggle-{{ ai_gen_id }} {
    background: none;
    border: none;
    color: {{ block.settings.toggle_color }};
    font-size: {{ block.settings.text_size | minus: 2 }}px;
    cursor: pointer;
    padding: 8px 0 0;
    text-decoration: underline;
    transition: opacity 0.2s ease;
  }

  .ai-testimonial-toggle-{{ ai_gen_id }}:hover {
    opacity: 0.7;
  }

  .ai-testimonial-toggle-{{ ai_gen_id }}.hidden {
    display: none;
  }

  .ai-testimonial-author-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-top: auto;
    padding-top: 16px;
    border-top: 1px solid {{ block.settings.divider_color }};
  }

  .ai-testimonial-avatar-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }

  .ai-testimonial-avatar-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.avatar_size }}px;
    height: {{ block.settings.avatar_size }}px;
    border-radius: 50%;
    background-color: {{ block.settings.avatar_placeholder_bg }};
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }

  .ai-testimonial-avatar-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    fill: {{ block.settings.avatar_placeholder_color }};
  }

  .ai-testimonial-author-info-{{ ai_gen_id }} {
    flex-grow: 1;
  }

  .ai-testimonial-author-name-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_name_size }}px;
    font-weight: 600;
    color: {{ block.settings.author_name_color }};
    margin: 0 0 4px;
  }

  .ai-testimonial-author-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.author_title_size }}px;
    color: {{ block.settings.author_title_color }};
    margin: 0;
  }

  .ai-testimonials-nav-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 32px;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }} {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_bg }};
    border: 1px solid {{ block.settings.nav_button_border }};
    color: {{ block.settings.nav_button_color }};
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_bg }};
    color: {{ block.settings.nav_button_hover_color }};
  }

  .ai-testimonials-nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  @media screen and (max-width: 989px) {
    .ai-testimonial-card-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - {{ block.settings.card_gap }}px * ({{ block.settings.cards_per_view_tablet | minus: 1 }})) / {{ block.settings.cards_per_view_tablet }});
    }
  }

  @media screen and (max-width: 749px) {
    .ai-testimonial-card-{{ ai_gen_id }} {
      flex: 0 0 100%;
    }

    .ai-testimonials-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_size | times: 0.8 }}px;
    }
  }
{% endstyle %}

<testimonials-carousel-{{ ai_gen_id }}
  class="ai-testimonials-carousel-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-testimonials-container-{{ ai_gen_id }}">
    {% if block.settings.title != blank or block.settings.subtitle != blank %}
      <div class="ai-testimonials-header-{{ ai_gen_id }}">
        {% if block.settings.title != blank %}
          <h2 class="ai-testimonials-title-{{ ai_gen_id }}">{{ block.settings.title }}</h2>
        {% endif %}
        {% if block.settings.subtitle != blank %}
          <p class="ai-testimonials-subtitle-{{ ai_gen_id }}">{{ block.settings.subtitle }}</p>
        {% endif %}
      </div>
    {% endif %}

    <div class="ai-testimonials-carousel-wrapper-{{ ai_gen_id }}">
      <div class="ai-testimonials-track-{{ ai_gen_id }}" data-track>
        {% for i in (1..6) %}
          {% liquid
            assign testimonial_key = 'testimonial_' | append: i
            assign author_key = 'author_' | append: i
            assign title_key = 'author_title_' | append: i
            assign rating_key = 'rating_' | append: i
            assign avatar_key = 'avatar_' | append: i

            assign testimonial = block.settings[testimonial_key]
            assign author = block.settings[author_key]
            assign author_title = block.settings[title_key]
            assign rating = block.settings[rating_key]
            assign avatar = block.settings[avatar_key]
          %}

          {% if testimonial != blank %}
            <div class="ai-testimonial-card-{{ ai_gen_id }}">
              {% if rating > 0 %}
                <div class="ai-testimonial-stars-{{ ai_gen_id }}">
                  {% for star in (1..5) %}
                    {% if star <= rating %}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="currentColor">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% else %}
                      <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.5">
                        <path d="M10 15l-5.878 3.09 1.123-6.545L.489 6.91l6.572-.955L10 0l2.939 5.955 6.572.955-4.756 4.635 1.123 6.545z"/>
                      </svg>
                    {% endif %}
                  {% endfor %}
                </div>
              {% endif %}

              <div class="ai-testimonial-text-wrapper-{{ ai_gen_id }}">
                <p class="ai-testimonial-text-{{ ai_gen_id }} collapsed" data-text>
                  {{ testimonial }}
                </p>
                <button class="ai-testimonial-toggle-{{ ai_gen_id }} hidden" data-toggle>
                  <span data-read-more>Read more</span>
                  <span data-show-less style="display: none;">Show less</span>
                </button>
              </div>

              <div class="ai-testimonial-author-{{ ai_gen_id }}">
                {% if avatar != blank %}
                  <img
                    src="{{ avatar | image_url: width: 100 }}"
                    alt="{{ author | escape }}"
                    class="ai-testimonial-avatar-{{ ai_gen_id }}"
                    loading="lazy"
                    width="100"
                    height="100"
                  >
                {% else %}
                  <div class="ai-testimonial-avatar-placeholder-{{ ai_gen_id }}">
                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                      <path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="ai-testimonial-author-info-{{ ai_gen_id }}">
                  {% if author != blank %}
                    <p class="ai-testimonial-author-name-{{ ai_gen_id }}">{{ author }}</p>
                  {% endif %}
                  {% if author_title != blank %}
                    <p class="ai-testimonial-author-title-{{ ai_gen_id }}">{{ author_title }}</p>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>
    </div>

    <div class="ai-testimonials-nav-{{ ai_gen_id }}">
      <button
        class="ai-testimonials-nav-button-{{ ai_gen_id }}"
        data-prev
        aria-label="Previous testimonial"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M15 18l-6-6 6-6"/>
        </svg>
      </button>
      <button
        class="ai-testimonials-nav-button-{{ ai_gen_id }}"
        data-next
        aria-label="Next testimonial"
      >
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M9 18l6-6-6-6"/>
        </svg>
      </button>
    </div>
  </div>
</testimonials-carousel-{{ ai_gen_id }}>

<script>
  (function() {
    class TestimonialsCarousel{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentIndex = 0;
        this.cardsPerView = {{ block.settings.cards_per_view }};
      }

      connectedCallback() {
        this.track = this.querySelector('[data-track]');
        this.prevButton = this.querySelector('[data-prev]');
        this.nextButton = this.querySelector('[data-next]');
        this.cards = this.querySelectorAll('.ai-testimonial-card-{{ ai_gen_id }}');
        this.totalCards = this.cards.length;

        this.setupToggleButtons();
        this.setupNavigation();
        this.updateCardsPerView();
        this.updateNavButtons();

        window.addEventListener('resize', () => {
          this.updateCardsPerView();
          this.updateSlidePosition();
        });
      }

      setupToggleButtons() {
        this.cards.forEach((card) => {
          const textElement = card.querySelector('[data-text]');
          const toggleButton = card.querySelector('[data-toggle]');
          const readMoreSpan = toggleButton.querySelector('[data-read-more]');
          const showLessSpan = toggleButton.querySelector('[data-show-less]');

          if (textElement.scrollHeight > textElement.clientHeight) {
            toggleButton.classList.remove('hidden');
          }

          toggleButton.addEventListener('click', () => {
            const isCollapsed = textElement.classList.contains('collapsed');

            if (isCollapsed) {
              textElement.classList.remove('collapsed');
              textElement.classList.add('expanded');
              readMoreSpan.style.display = 'none';
              showLessSpan.style.display = 'inline';
            } else {
              textElement.classList.remove('expanded');
              textElement.classList.add('collapsed');
              readMoreSpan.style.display = 'inline';
              showLessSpan.style.display = 'none';
            }
          });
        });
      }

      setupNavigation() {
        this.prevButton.addEventListener('click', () => {
          if (this.currentIndex > 0) {
            this.currentIndex--;
            this.updateSlidePosition();
          }
        });

        this.nextButton.addEventListener('click', () => {
          if (this.currentIndex < this.totalCards - this.cardsPerView) {
            this.currentIndex++;
            this.updateSlidePosition();
          }
        });
      }

      updateCardsPerView() {
        const width = window.innerWidth;
        if (width <= 749) {
          this.cardsPerView = 1;
        } else if (width <= 989) {
          this.cardsPerView = {{ block.settings.cards_per_view_tablet }};
        } else {
          this.cardsPerView = {{ block.settings.cards_per_view }};
        }
      }

      updateSlidePosition() {
        const cardWidth = this.cards[0].offsetWidth;
        const gap = {{ block.settings.card_gap }};
        const offset = -(this.currentIndex * (cardWidth + gap));
        this.track.style.transform = `translateX(${offset}px)`;
        this.updateNavButtons();
      }

      updateNavButtons() {
        this.prevButton.disabled = this.currentIndex === 0;
        this.nextButton.disabled = this.currentIndex >= this.totalCards - this.cardsPerView;
      }
    }

    customElements.define('testimonials-carousel-{{ ai_gen_id }}', TestimonialsCarousel{{ ai_gen_id }});
  })();
</script>

